---
import type { HTMLAttributes } from "astro/types";

export type Props = HTMLAttributes<"button">;
---

<button {...Astro.props}><slot /></button>

<style>
  @property --a {
    syntax: "<angle>";
    inherits: false;
    initial-value: 10deg;
  }

  @keyframes rotate {
    0% {
      --a: 0deg;
    }
    100% {
      --a: 360deg;
    }
  }
  button {
    --a: 0deg;
    background:
      linear-gradient(in oklch, oklch(100% 0 0), oklch(100% 0 0)) padding-box,
      linear-gradient(
          var(--a) in oklch,
          oklch(64.06% 0.197 252.97),
          oklch(57.6% 0.298 305.847)
        )
        border-box;
    padding: 6px;
    border: 5px solid transparent;
    border-radius: 8px;
    display: inline-block;
    font-size: 20px;
    animation: rotate 20s linear infinite;
    cursor: pointer;
  }
</style>
